# Defense-in-depth: if this folder is ever reachable over HTTP — for
# example because a shared host won't let the document root be moved
# above public/ — deny every request outright. Apache 2.4+ and 2.2
# syntax are both included since we can't know the host's version.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
