APP_NAME=StockPilot
APP_ENV=local
APP_URL=http://localhost/StockPilot/public
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=stockpilot
DB_USER=root
DB_PASS=

SESSION_NAME=stockpilot_session
SESSION_LIFETIME=1800
INVOICE_PREFIX=SP
STORE_NAME="Your Store Name"
STORE_ADDRESS="Your Store Address"
STORE_GSTIN=

# WhatsApp Cloud API (Meta) — leave blank until you have a Business account.
# See app/Services/WhatsAppService.php for the full setup checklist.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=invoice_ready

# ---- Email notifications (App\Notifications\Mailer) ----
# InfinityFree (and most free shared hosts) blocks outbound SMTP to
# arbitrary hosts, so MAIL_HOST must be an external relay provider —
# e.g. smtp-relay.brevo.com, smtp.gmail.com (with an App Password),
# or Mailtrap/SendGrid's SMTP endpoint. Leave MAIL_HOST blank to
# disable email entirely — the app degrades gracefully either way.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME=StockPilot
# Where security-critical alerts (new admin, role change, suspicious
# login) are sent. Leave blank to disable — never hardcode this in code.
MAIL_ADMIN_ADDRESS=

# Login throttling
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_WINDOW_SECONDS=900
